{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Zomfy",
  "version": "0.2.11",
  "identifier": "io.github.tsubasa-km.zomfy",
  "build": {
    "beforeDevCommand": "bun run --cwd ../../packages/daemon build && bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run --cwd ../../packages/daemon build && bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Zomfy",
        "width": 1280,
        "height": 820,
        "maximized": true,
        "visible": false,
        "minWidth": 720,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": "default-src 'self'; frame-src http: https:; connect-src 'self' ipc: http://ipc.localhost ws://127.0.0.1:*; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI0RDc1NkZFQTQ5QjVERTAKUldUZ1hadWsvbGJYdE1rSGFweHRwbG9aWjBDbjVSMGdTSmtGYm92YzBDVkJ4N0pjbVZhNG1GQm8K",
      "endpoints": [
        "https://github.com/tsubasa-km/zomfy/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
