{
  "name": "zomfy",
  "private": true,
  "type": "module",
  "workspaces": ["packages/*", "apps/*"],
  "scripts": {
    "daemon": "bun --cwd packages/daemon start",
    "typecheck": "bun --filter '*' typecheck",
    "relay:vendor": "bun scripts/relay-vendor.ts",
    "relay:local": "bun --cwd apps/relay run local",
    "mobile:apk": "bun --cwd apps/mobile run apk"
  }
}
